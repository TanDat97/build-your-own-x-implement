# Project-specific ignores for sqlite/. Generic build artifacts (*.o, *.a, …),
# debug/crash files and editor/OS noise live in the repo-root .gitignore.

# Build output (Makefile targets)
main
tests/test_db

# Generated files: test.db, trace.db, trace.html and viz.html all go in output/
output/

# Database files from running the REPL by hand
*.db

# VS Code: shared configs are kept, everything else is local
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
