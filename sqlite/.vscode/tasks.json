{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build main",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-O0",
        "-Wall",
        "${workspaceFolder}/main.c",
        "-o",
        "${workspaceFolder}/main"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
